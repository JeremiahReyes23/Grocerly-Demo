# Grocerly development configuration (example only)
# Public project URL; safe to include in a frontend configuration.
SUPABASE_URL=https://qbmcsqvyeozgetznlgjc.supabase.co

# Set the project Publishable Key (sb_publishable_...) privately in your
# hosting environment. This key is public, but never place service-role
# or secret keys in browser JavaScript.
SUPABASE_PUBLISHABLE_KEY=

# If later using a Vite client build, use these public client variables:
# VITE_SUPABASE_URL=https://qbmcsqvyeozgetznlgjc.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER set SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in a frontend variable.
